# Local dev: leave unset, client.js falls back to http://127.0.0.1:8000/api
# Production (Vercel/Netlify/Cloudflare Pages): set this to your deployed
# backend URL, e.g. https://pacha-backend.onrender.com/api
VITE_API_BASE_URL=

# Supabase project settings -> API. The "anon" key is safe to expose in the
# frontend (it's public by design - real access control happens in the
# FastAPI backend, which verifies the JWT on every request).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
